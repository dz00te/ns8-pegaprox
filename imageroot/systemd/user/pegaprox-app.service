[Unit]
Description=Podman  pegaprox-app.service
BindsTo=pegaprox.service
After=pegaprox.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/smarthost.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/pegaprox-app.pid %t/pegaprox-app.ctr-id
ExecStartPre=/bin/bash -c "test -s %S/state/cert.pem || openssl req -x509 -newkey rsa:2048 -nodes -keyout %S/state/key.pem -out %S/state/cert.pem -days 3650 -subj /CN=pegaprox"
ExecStart=/usr/bin/podman run --conmon-pidfile %t/pegaprox-app.pid  --cidfile %t/pegaprox-app.ctr-id --cgroups=no-conmon  --pod-id-file %t/pegaprox.pod-id --replace -d --name  pegaprox-app  --user 0:0  --volume pegaprox-config:/app/config:Z --volume %S/state/cert.pem:/app/cert.pem:Z --volume %S/state/key.pem:/app/key.pem:Z   --env-file pegaprox.env  ${PEGAPROX_APP_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/pegaprox-app.ctr-id -t 10
ExecReload=/usr/bin/podman kill -s HUP pegaprox-app
SyslogIdentifier=%u
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/pegaprox-app.ctr-id
PIDFile=%t/pegaprox-app.pid
Type=forking

[Install]
WantedBy=default.target
