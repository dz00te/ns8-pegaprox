#
# This systemd unit starts a ns8-pegaprox instance using Podman.
# Most parts of this file come from podman-generate-systemd.
#

[Unit]
Description=Podman ns8-pegaprox.service
Requires=pegaprox-app.service 
Before=pegaprox-app.service 

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/ns8-pegaprox.pid %t/ns8-pegaprox.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/ns8-pegaprox.pid  --pod-id-file %t/ns8-pegaprox.pod-id  --name ns8-pegaprox  --publish 127.0.0.1:${TCP_PORT}:80  --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/ns8-pegaprox.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/ns8-pegaprox.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/ns8-pegaprox.pod-id
PIDFile=%t/ns8-pegaprox.pid
Type=forking

[Install]
WantedBy=default.target
