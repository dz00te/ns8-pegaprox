# Ensure 3 TCP ports are allocated for pegaprox (main + VNC WS + SSH WS)
#
import agent
import os

tcp_ports = os.environ.get('TCP_PORTS', '')

if tcp_ports.count(',') < 2:  # less than 3 ports
    print("Expanding port allocation to 3 ports")
    result = agent.allocate_ports(3, "tcp")
    new_start = result[0]
    agent.set_env('TCP_PORT', str(new_start))
    agent.set_env('TCP_PORTS', f'{new_start},{new_start+1},{new_start+2}')
    print(f"Port allocation updated: {new_start}-{new_start+2}")
else:
    print(f"Port allocation already correct: {tcp_ports}")
