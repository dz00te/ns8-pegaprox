# Ensure the Traefik route uses http:// (PEGAPROX_BEHIND_PROXY=true)
# Re-applies on every update in case the route was set by an older
# module version that used https://
#
import os
import sys
import agent
import agent.tasks

host = os.environ.get('TRAEFIK_HOST')
if not host:
    # Not configured yet, nothing to do
    sys.exit(0)

h2hs = os.environ.get('TRAEFIK_HTTP2HTTPS') == 'True'
le = os.environ.get('TRAEFIK_LETS_ENCRYPT') == 'True'

default_traefik_id = agent.resolve_agent_id('traefik@node')
if default_traefik_id is None:
    sys.exit(0)

response = agent.tasks.run(
    agent_id=default_traefik_id,
    action='set-route',
    data={
        'instance': os.environ['MODULE_ID'],
        'url': 'http://127.0.0.1:' + os.environ["TCP_PORT"],
        'host': host,
        'http2https': h2hs,
        'lets_encrypt': le,
        'skip_cert_verify': True
    },
)
agent.assert_exp(response['exit_code'] == 0)
